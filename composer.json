{
    "name": "moffhub/maker-checker",
    "description": "Enterprise-grade maker-checker (four-eyes) approval workflow for Laravel. Multi-role approvals, conditional rules engine, delegation, audit trail, bulk actions, and auto-intercept via Eloquent events.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "maker-checker",
        "approval-workflow",
        "four-eyes",
        "authorization",
        "approval",
        "workflow",
        "multi-level-approval",
        "audit-trail",
        "delegation",
        "role-based",
        "pending-approval",
        "eloquent",
        "laravel-package"
    ],
    "homepage": "https://github.com/moffhub/maker-checker",
    "support": {
        "issues": "https://github.com/moffhub/maker-checker/issues",
        "source": "https://github.com/moffhub/maker-checker"
    },
    "autoload": {
        "psr-4": {
            "Moffhub\\MakerChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moffhub\\MakerChecker\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Moffat Munene",
            "email": "moffmu@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4 || ^8.5",
        "illuminate/support": "^12.0 || ^13.0",
        "sourcetoad/enhanced-resources": "^7.3"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.6 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.5",
        "rector/rector": "^2.0",
        "sourcetoad/rule-helper-for-laravel": "^6.3"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moffhub\\MakerChecker\\MakerCheckerServiceProvider"
            ]
        }
    },
    "scripts": {
        "check-code": [
            "@lint",
            "@phpstan",
            "@test"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "lint:fix": [
            "vendor/bin/pint"
        ],
        "phpstan": [
            "vendor/bin/phpstan --memory-limit=512M"
        ],
        "rector": [
            "vendor/bin/rector process --dry-run"
        ],
        "rector:fix": [
            "vendor/bin/rector process"
        ],
        "test": [
            "vendor/bin/phpunit"
        ]
    }
}
