{
    "name": "moffhub/maker-checker",
    "description": "A laravel package to help manage with maker checker tight requirement",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Moffhub\\MakerChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moffhub\\MakerChecker\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Moffat Munene",
            "email": "moffmu@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0",
        "sourcetoad/enhanced-resources": "^7.1"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^10.6",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moffhub\\MakerChecker\\MakerCheckerServiceProvider"
            ]
        }
    },
    "scripts": {
        "check-code": [
            "@lint",
            "@phpstan",
            "@test"
        ],
        "lint": [
            "vendor/bin/pint --test"
        ],
        "lint:fix": [
            "vendor/bin/pint"
        ],
        "phpstan": [
            "vendor/bin/phpstan"
        ],
        "test": [
            "vendor/bin/phpunit"
        ]
    }
}
